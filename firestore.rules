rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper validation functions
    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    // LEADS COLLECTION: ZERO-TRUST BLIND WRITE
    match /leads/{leadId} {
      
      // 1. ABSOLUTE PRIVACY: Public clients can NEVER read, query, update, or delete.
      // Only project owners in Firebase Console can view customer leads.
      allow read, update, delete: if false;

      // 2. SCHEMA VALIDATION ON CREATE
      allow create: if 
        // Must contain required fields
        request.resource.data.keys().hasAll(['name', 'email', 'phone', 'status', 'createdAt']) &&
        
        // Data type and bounds enforcement
        isValidString(request.resource.data.name, 1, 100) &&
        isValidString(request.resource.data.email, 5, 120) &&
        isValidString(request.resource.data.phone, 7, 30) &&
        
        // Status must be 'new'
        request.resource.data.status == 'new' &&
        
        // Timestamp must match request.time (ensures serverTimestamp() was used)
        (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);
    }

    // Catch-all: Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
